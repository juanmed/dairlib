<?xml version="1.0"?>
<sdf xmlns:drake="http://drake.mit.edu" version="1.7">
  <model name="box">
    <link name="box_1">
      <pose>0.3 0.7 0.9 0 0 0</pose>
      <visual name="box_1_visual">
        <geometry>
          <box>
            <size>0.3 0.3 0.15</size>
          </box>
        </geometry>
        <material>
          <ambient>1.0 0.0 0.0 0.6</ambient> <!-- Red -->
          <diffuse>1.0 0.0 0.0 0.6</diffuse>
        </material>
      </visual>
      <collision name="box_1_collision">
        <geometry>
          <box>
            <size>0.3 0.3 0.15</size>
          </box>
        </geometry>
        <drake:proximity_properties>
          <drake:compliant_hydroelastic/>
          <drake:hydroelastic_modulus>1e5</drake:hydroelastic_modulus>
          <drake:mesh_resolution_hint>0.01</drake:mesh_resolution_hint>
          <drake:mu_dynamic>1.4</drake:mu_dynamic>
          <drake:mu_static>1.5</drake:mu_static>
          <drake:hunt_crossley_dissipation>5</drake:hunt_crossley_dissipation>
        </drake:proximity_properties>
      </collision>
    </link>
  </model>
</sdf>