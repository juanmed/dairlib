package(default_visibility = ["//visibility:public"])

filegroup(
    name = "configs",
    srcs = glob(["config/**/*.yaml"]),
)

cc_library(
    name = "parameters",
    hdrs = [
      "parameters/box_repositioning_config.h",
    ],
    deps = [
      "@drake//:drake_shared_library",
    ]
)

cc_binary(
    name = "run_simulation",
    srcs = ["box_repositioning_simulation.cc"],
    data = [
      ":configs",
      "@drake_models//:franka_description",
    ],
    deps = [
      ":parameters",
      "//common",
      "//examples/plate-balancing:parameters",
      "//examples/plate-balancing/systems:franka_systems",
      "//systems:robot_lcm_systems",
      "//systems:system_utils",
      "//systems/controllers",
      "//systems/framework:lcm_driven_loop",
      "//systems/lcmt_systems:lcmt_systems",
      "//systems/primitives:radio_parser",
      "@drake//:drake_shared_library",
      "@gflags",
    ]

)

cc_binary(
    name = "run_visualizer",
    srcs = ["box_repositioning_visualizer.cc"],
    data = [
        ":configs",
        "@drake_models//:franka_description",
    ],
    deps = [
        ":parameters",
        "//common",
        "//examples/plate-balancing:parameters",
        "//multibody:utils",
        "//multibody:visualization_utils",
        "//systems:robot_lcm_systems",
        "//systems:system_utils",
        "//systems/primitives",
        "//systems/trajectory_optimization:lcm_trajectory_systems",
        "//systems/lcmt_systems:lcmt_systems",
        "//examples/plate-balancing/systems/visualization:visualization_systems",
        "@c3//lcmtypes:lcmt_c3",
        "@drake//:drake_shared_library",
        "@gflags",
    ],
)